{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/core/knowledge/match.ts",
    "src/core/games/cyberpunk2077/knowledge.ts",
    "vite.web.config.ts"
  ]
}
